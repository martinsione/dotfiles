Include devbox.config
Include /Users/martin-vercel/.ssh/conductor_config

# UseKeychain is macOS-only; without this, Linux ssh refuses the whole file.
IgnoreUnknown UseKeychain

Host *
  SetEnv TERM=xterm-256color
  # Reuse one connection per host so new tabs/panes skip the handshake + auth.
  ControlMaster auto
  ControlPath ~/.ssh/cm-%C
  ControlPersist 10m
  ServerAliveInterval 30
  ServerAliveCountMax 4

Host github.com
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519

Host devbox
  HostName 100.121.241.122
  User martin
  ForwardAgent yes
  ExitOnForwardFailure no
  LogLevel QUIET

  # Port forwarding
  LocalForward 1355 127.0.0.1:1355 # portless
  # LocalForward 3000 localhost:3000
  # LocalForward 3001 localhost:3001
  # LocalForward 4096 localhost:4096 # opencode

Host root-reliablesite
  HostName 100.118.123.36
  User root
  ForwardAgent yes
