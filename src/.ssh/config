Host *
  SetEnv TERM=xterm-256color

Host github.com
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519

Host devbox
  Compression yes
  ForwardAgent yes
  ExitOnForwardFailure no
  LogLevel QUIET

  # Port forwarding
  LocalForward 3000 localhost:3000
  LocalForward 4096 localhost:4096 # opencode
