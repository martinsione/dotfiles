{
  "editor.tabSize": 2,
  "files.exclude": { "**/.git": false },
  "cursor.composer.collapsePaneInputBoxPills": true,
  "cursor.composer.shouldAllowCustomModes": true,
  "cursor.composer.shouldChimeAfterChatFinishes": true,
  "cursor.cpp.enablePartialAccepts": true,
  "cursor.diffs.useCharacterLevelDiffs": true,
  "cursor.windowSwitcher.sidebarHoverCollapsed": true,
  "diffEditor.renderSideBySide": false,
  "editor.fontFamily": "'JetBrainsMono Nerd Font'",
  "editor.fontLigatures": true,
  "editor.fontSize": 13,
  "editor.formatOnSave": true,
  "editor.hideCursorInOverviewRuler": true,
  "editor.lineHeight": 2,
  "editor.lineNumbers": "relative",
  "editor.minimap.enabled": false,
  "editor.overviewRulerBorder": false,
  "editor.rulers": [80],
  "editor.wordWrap": "on",
  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "terminal.integrated.fontSize": 13,
  "update.releaseTrack": "prerelease",
  "window.autoDetectColorScheme": true,
  "window.commandCenter": false,
  "window.density.editorTabHeight": "compact",
  "window.nativeTabs": true,
  "window.title": "${folderPath}",
  "workbench.activityBar.location": "hidden",
  "workbench.activityBar.orientation": "vertical",
  // "workbench.editor.editorActionsLocation": "hidden",
  "workbench.layoutControl.enabled": false,
  "workbench.navigationControl.enabled": false,
  "workbench.preferredDarkColorTheme": "Cursor Dark",
  "workbench.preferredLightColorTheme": "Cursor Light",
  "workbench.sideBar.location": "right",
  // "workbench.statusBar.visible": false,
  // Lang specific
  "json.schemaDownload.enable": true,
  // VIM plugin
  "vim.highlightedyank.duration": 150,
  "vim.highlightedyank.enable": true,
  "vim.useCtrlKeys": true,
  "vim.useSystemClipboard": true,
  "vim.normalModeKeyBindings": [
    { "before": ["Y"], "after": ["y", "$"] },
    { "before": ["[", "b"], "commands": ["workbench.action.previousEditor"] },
    { "before": ["]", "b"], "commands": ["workbench.action.nextEditor"] },
    { "before": ["K"], "commands": ["editor.action.showHover"] },
    { "before": ["g", "r"], "commands": ["editor.action.goToReferences"] },
    {
      "before": ["<space>", "b", "d"],
      "commands": ["workbench.action.closeActiveEditor"]
    },
    {
      "before": ["<space>", "b", "u"],
      "commands": ["workbench.action.reopenClosedEditor"]
    },
    { "before": ["<space>", "r", "n"], "commands": ["editor.action.rename"] }
  ],
  "vim.visualModeKeyBindings": [
    { "before": [">"], "after": [">", "g", "v"] },
    { "before": ["<"], "after": ["<", "g", "v"] }
  ],
  "editor.accessibilitySupport": "off",
  "claudeCode.preferredLocation": "panel",
  "claudeCode.selectedModel": "opus",
}
