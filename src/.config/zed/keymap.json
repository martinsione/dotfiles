[
  {
    "context": "Workspace",
    "bindings": {
      "cmd-b": "workspace::ToggleRightDock",
      "cmd-i": "agent::ToggleFocus",
      "cmd-l": "workspace::ToggleLeftDock",
      "cmd-shift-g": "git_panel::ToggleFocus",
      "cmd-t": "workspace::NewCenterTerminal",
      "ctrl-tab": "pane::ActivateNextItem",
      "ctrl-shift-tab": "pane::ActivatePreviousItem",
      "ctrl-cmd-p": "git::Worktree"
    },
    "unbind": {
      "ctrl-`": "terminal_panel::Toggle",
      "cmd-t": "project_symbols::Toggle",
      "ctrl-tab": "tab_switcher::Toggle",
      "ctrl-shift-tab": ["tab_switcher::Toggle", { "select_last": true }],
      "ctrl-cmd-w": "git::Worktree"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-cmd-p": "editor::AddSelectionAbove",
      "cmd-l": "editor::SelectLine"
    }
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "cmd-k": "assistant::InlineAssist"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "use_key_equivalents": true,
    "bindings": {
      "a": "project_panel::NewFile",
      "l": "project_panel::OpenPermanent",
      "r": "project_panel::Rename",
      "space e": "workspace::ToggleRightDock"
    }
  },
  {
    "context": "vim_mode == normal",
    "bindings": {
      "[ b": "pane::ActivatePreviousItem",
      "] b": "pane::ActivateNextItem",
      "space g r": "editor::FindAllReferences",
      "space r n": "editor::Rename",
      "space b d": "pane::CloseActiveItem",
      "space b u": "pane::ReopenClosedItem",
      "space e": "workspace::ToggleRightDock",
      "space space": "tab_switcher::OpenInActivePane"
    }
  }
]
