[alias]
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset' --abbrev-commit --date=relative
    st = status --short --branch -M

[core]
    editor = nvim

[pull]
    rebase = true

[rebase]
    autoStash = true

[push]
    default = current
[gpg]
	format = ssh
[commit]
	gpgsign = true
