{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "apiKeyHelper": "$HOME/.local/bin/ai-gateway-key",
  "cleanupPeriodDays": 99999,
  "env": {
    "CLAUDE_CODE_SKIP_FAST_MODE_ORG_CHECK": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "ANTHROPIC_BASE_URL": "https://ai-gateway.vercel.sh/claude-code",
    "ANTHROPIC_API_KEY": "",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1"
  },
  "permissions": {
    "allow": [
      "Bash(vb update:*)",
      "Bash(vb reply:*)",
      "Bash(vb read:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "pstack@cursor-plugins": true,
    "slack@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typesafe@typesafe-ai": true,
    "vercel@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    },
    "cursor-plugins": {
      "source": {
        "source": "github",
        "repo": "cursor/plugins"
      },
      "autoUpdate": true
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(vercel:deploy)"
    ]
  }
}
